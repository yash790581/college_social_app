<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@500;700;800&family=Plus+Jakarta+Sans:wght@400;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="error-page">
  <div class="container text-center" style="padding: 100px 20px;">
    <h1 style="font-size: 5rem; margin-bottom: 12px; color: #818cf8;">404</h1>
    <h2 style="font-size: 1.8rem; margin-bottom: 16px;"><%= brandName %> - Page Not Found</h2>
    <p style="color: #94a3b8; max-width: 480px; margin: 0 auto 32px auto;">
      The page you are looking for does not exist in this prototype.
    </p>
    <a href="/" class="btn-find-game" style="text-decoration: none; display: inline-flex; align-items: center;">
      <span class="btn-primary-text">Return to SweetPlay Home</span>
    </a>
  </div>
</body>
</html>

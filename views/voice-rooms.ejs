<%- include('partials/header') %>

<main class="main-content voice-rooms-page" id="voiceRoomsMainContainer">
  <!-- Prototype Banner Alert -->
  <section class="banner-section">
    <div class="container">
      <div class="prototype-banner" role="alert">
        <div class="banner-icon">🎙️</div>
        <div class="banner-content">
          <strong class="banner-title"><%= prototypeBadge %> • Campus Lounges</strong>
          <p class="banner-desc"><%= prototypeNotice %></p>
        </div>
      </div>
    </div>
  </section>

  <!-- Hero Section -->
  <section class="voice-directory-hero">
    <div class="container">
      <span class="badge-pill badge-primary">Campus Audio Hub</span>
      <h1 class="voice-directory-title">Campus Voice Rooms</h1>
      <p class="voice-directory-desc">
        Jump into audio-only study lounges, dorm hangouts, or club meetups with up to 6 students.
        Browser-to-browser WebRTC voice with shared group text chat.
      </p>

      <div class="voice-hub-actions-bar">
        <button type="button" class="btn-open-create-voice" id="btnOpenCreateVoiceModal">
          <span class="btn-icon">✨</span>
          <span>Create Voice Lounge</span>
        </button>
        <button type="button" class="btn-open-join-voice" id="btnOpenJoinVoiceModal">
          <span class="btn-icon">🚪</span>
          <span>Join with Code</span>
        </button>
      </div>
    </div>
  </section>

  <!-- Active Rooms Section -->
  <section class="active-rooms-section">
    <div class="container">
      <div class="section-title-wrap mb-3">
        <h2 class="section-title" style="font-size: 1.35rem; color: #f8fafc; font-family: var(--font-heading);">
          Active Voice Lounges
        </h2>
        <span class="badge-pill badge-outline" id="activeVoiceCountBadge">
          <%= activeRooms.length %> Active Room<%= activeRooms.length === 1 ? '' : 's' %>
        </span>
      </div>

      <% if (activeRooms && activeRooms.length > 0) { %>
        <div class="voice-rooms-grid">
          <% activeRooms.forEach(function(room) { %>
            <div class="voice-room-card" data-room-code="<%= room.code %>">
              <div class="voice-room-card-top">
                <span class="voice-room-code"><%= room.code %></span>
                <span class="voice-room-tag">Voice Lounge</span>
              </div>

              <h3 class="voice-room-title"><%= room.name %></h3>

              <div class="voice-room-meta-row">
                <span class="voice-room-host">Hosted by <strong><%= room.hostName %></strong></span>
              </div>

              <div class="voice-room-stats">
                <span class="voice-room-players-badge">
                  👥 <%= room.playerCount %>/<%= room.maxPlayers %> Seated
                  <% if (room.voiceCount > 0) { %>
                    • 🎙️ <%= room.voiceCount %> in Voice
                  <% } %>
                </span>
                <a href="/voice-rooms/room/<%= room.code %>" class="btn-enter-voice-room">
                  <span>Enter</span>
                  <span class="btn-arrow">→</span>
                </a>
              </div>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <div class="voice-rooms-empty-card">
          <div class="empty-card-icon">☕</div>
          <h3 class="empty-card-title">No Active Voice Lounges Yet</h3>
          <p class="empty-card-text">
            Start the first audio room for your campus quad! Rooms support up to 6 students with real-time text chat and WebRTC audio.
          </p>
          <button type="button" class="btn-open-create-voice" id="btnEmptyCreateVoice">
            <span>Create a Voice Lounge</span>
            <span class="btn-arrow">→</span>
          </button>
        </div>
      <% } %>

      <!-- Suggested Room Ideas / Themes -->
      <div class="suggested-themes-section mt-4 mb-5">
        <h3 class="mb-3" style="font-size: 1.1rem; color: #cbd5e1; font-family: var(--font-heading);">
          💡 Popular Lounge Themes
        </h3>
        <div class="campus-scope-grid" style="grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));">
          <% suggestedThemes.forEach(function(theme) { %>
            <div class="theme-card mode-card" data-theme-title="<%= theme.title %>" style="cursor: pointer;">
              <div class="mode-card-icon-wrap" style="font-size: 1.6rem;"><%= theme.icon %></div>
              <div class="mode-card-content">
                <div class="mode-card-header">
                  <h4 class="mode-card-title" style="font-size: 1rem;"><%= theme.title %></h4>
                </div>
                <p class="mode-card-desc" style="font-size: 0.8rem;"><%= theme.tag %></p>
              </div>
            </div>
          <% }); %>
        </div>
      </div>
    </div>
  </section>
</main>

<!-- Create Voice Room Modal Dialog -->
<div class="modal-backdrop" id="createVoiceModal" role="dialog" aria-modal="true" aria-labelledby="createVoiceModalTitle" hidden>
  <div class="modal-container">
    <div class="modal-header">
      <div class="modal-tag">Host a Lounge</div>
      <button class="modal-close-btn" id="createVoiceCloseBtn" aria-label="Close dialog">&times;</button>
    </div>

    <form id="createVoiceRoomForm" class="modal-body text-left">
      <div class="modal-icon text-center">🎙️</div>
      <h3 class="modal-title text-center" id="createVoiceModalTitle">Create Voice Lounge</h3>
      <p class="modal-mode-msg text-center">
        Host an audio room for your study group, dorm, or gaming team (up to 6 students).
      </p>

      <div class="form-group-wrap">
        <label for="voiceRoomNameInput" class="form-label">Lounge Name *</label>
        <input 
          type="text" 
          id="voiceRoomNameInput" 
          class="form-input-text" 
          placeholder="e.g. Quad Lo-Fi Study Table, CS Hangout" 
          maxlength="40" 
          required 
          autocomplete="off"
        />
      </div>

      <div class="form-group-wrap">
        <label for="voiceHostNickname" class="form-label">Your Nickname *</label>
        <input 
          type="text" 
          id="voiceHostNickname" 
          class="form-input-text" 
          placeholder="e.g. Alex, Sam, Jordan" 
          maxlength="20" 
          required 
          autocomplete="off"
        />
        <small class="form-hint">Displayed to other students at your table.</small>
      </div>

      <div class="form-group-wrap">
        <label for="voiceCustomCode" class="form-label">Custom Room Code (Optional)</label>
        <input 
          type="text" 
          id="voiceCustomCode" 
          class="form-input-text" 
          placeholder="e.g. LOUNGE-404, STUDY-88" 
          maxlength="15" 
          autocomplete="off"
          style="text-transform: uppercase;"
        />
        <small class="form-hint">Leave blank to automatically generate a memorable campus code.</small>
      </div>

      <div class="modal-footer modal-footer-actions">
        <button type="button" class="btn-modal-dismiss" id="createVoiceDismissBtn">Cancel</button>
        <button type="submit" class="btn-modal-impostor" id="btnSubmitCreateVoice">
          <span>Create & Enter Lounge</span>
          <span class="btn-arrow">→</span>
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Join Voice Room Modal Dialog -->
<div class="modal-backdrop" id="joinVoiceModal" role="dialog" aria-modal="true" aria-labelledby="joinVoiceModalTitle" hidden>
  <div class="modal-container">
    <div class="modal-header">
      <div class="modal-tag">Enter Lounge</div>
      <button class="modal-close-btn" id="joinVoiceCloseBtn" aria-label="Close dialog">&times;</button>
    </div>

    <form id="joinVoiceRoomForm" class="modal-body text-left">
      <div class="modal-icon text-center">🚪</div>
      <h3 class="modal-title text-center" id="joinVoiceModalTitle">Join Voice Lounge</h3>
      <p class="modal-mode-msg text-center">
        Enter the room code shared by your classmate.
      </p>

      <div class="form-group-wrap">
        <label for="joinVoiceCodeInput" class="form-label">Room Code *</label>
        <input 
          type="text" 
          id="joinVoiceCodeInput" 
          class="form-input-text" 
          placeholder="e.g. LOUNGE-104 or QUAD-312" 
          maxlength="15" 
          required 
          autocomplete="off"
          style="text-transform: uppercase; font-weight: 700; letter-spacing: 0.05em;"
        />
      </div>

      <div class="form-group-wrap">
        <label for="joinVoiceNicknameInput" class="form-label">Your Nickname *</label>
        <input 
          type="text" 
          id="joinVoiceNicknameInput" 
          class="form-input-text" 
          placeholder="e.g. Taylor, Morgan" 
          maxlength="20" 
          required 
          autocomplete="off"
        />
      </div>

      <div class="modal-footer modal-footer-actions">
        <button type="button" class="btn-modal-dismiss" id="joinVoiceDismissBtn">Cancel</button>
        <button type="submit" class="btn-modal-impostor" id="btnSubmitJoinVoice">
          <span>Join Lounge</span>
          <span class="btn-arrow">→</span>
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Toast Alert -->
<div class="prototype-toast" id="prototypeToast" role="status" aria-live="polite" hidden>
  <span class="toast-icon" id="toastIcon">ℹ️</span>
  <span class="toast-message" id="toastMessage">Notification</span>
</div>

<%- include('partials/footer') %>

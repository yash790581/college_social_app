      <nav class="main-nav" aria-label="Main Navigation">
        <ul class="nav-links">
          <li><a href="/" class="nav-link">Home</a></li>
          <li><a href="/campus-impostor" class="nav-link">Campus Impostor</a></li>
          <li><a href="/voice-rooms" class="nav-link">Voice Rooms</a></li>
          <li><a href="/#campus-selector" class="nav-link">Matchmaking</a></li>
          <li><a href="/#how-it-works" class="nav-link">How It Works</a></li>
          <li><span class="nav-tag">Verification (Future Feature)</span></li>
        </ul>
      </nav>

# SweetPlay Environment Configuration Example
# Copy this file to .env and adjust variables as needed.

PORT=3000
NODE_ENV=development

# WebRTC ICE Server Configuration
# By default, SweetPlay uses public STUN servers (stun:stun.l.google.com:19302)
# which allow browsers on typical Wi-Fi or broadband networks to discover their public IPs.
#
# IMPORTANT FOR PRODUCTION / CROSS-NETWORK DEPLOYMENT:
# In corporate, university dorm firewalls, or cellular carrier networks with symmetric NAT,
# direct peer-to-peer WebRTC connections may fail without a TURN relay server.
#
# To specify custom STUN and TURN servers, provide a JSON array formatted as follows:
# (Do NOT commit real TURN credentials to source control!)
#
# ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478?transport=udp","username":"sample_turn_username","credential":"sample_turn_password"}]
